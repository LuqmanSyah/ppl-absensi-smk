# Salin file ini menjadi .env, lalu sesuaikan nilainya:
#   cp .env.example .env

# Database PostgreSQL (sesuai docker-compose.yml)
DATABASE_URL="postgresql://absensi:absensi@localhost:5432/absensi"

# Kredensial container PostgreSQL (hanya dipakai docker-compose.yml)
POSTGRES_USER=absensi
POSTGRES_PASSWORD=absensi
POSTGRES_DB=absensi

# Kunci rahasia untuk menandatangani sesi/JWT login
# Generate dengan: openssl rand -base64 32
AUTH_SECRET=""

# Zona waktu sekolah, dipakai untuk menghitung status Terlambat
APP_TIMEZONE="Asia/Jakarta"
