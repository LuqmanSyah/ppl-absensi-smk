# Salin file ini menjadi .env, lalu sesuaikan nilainya:
#   cp .env.example .env

# Database PostgreSQL (sesuai docker-compose.yml)
DATABASE_URL="postgresql://absensi:absensi@localhost:5432/absensi"

# Kredensial container PostgreSQL (hanya dipakai docker-compose.yml)
POSTGRES_USER=absensi
POSTGRES_PASSWORD=absensi
POSTGRES_DB=absensi

# Kunci rahasia untuk menandatangani sesi/JWT login
# Generate dengan: openssl rand -base64 32
AUTH_SECRET=""

# Zona waktu sekolah, dipakai untuk menghitung status Terlambat
APP_TIMEZONE="Asia/Jakarta"

# Alamat aplikasi untuk isi QR Code (opsional). Jika kosong, diambil dari alamat yang
# sedang dibuka. Isi saat memakai tunnel/hosting, contoh: https://absensi.contoh.id
APP_URL=""

# Aturan absensi (opsional, nilai default di src/lib/config.ts)
LATE_AFTER_MINUTES=5
MAX_GPS_ACCURACY_M=50
OPEN_SESSION_EARLY_MINUTES=15

# Absen selesai (opsional): dibuka setelah sekian persen durasi pelajaran (default 2/3),
# dan masih diterima sekian menit setelah jam pelajaran berakhir.
CHECKOUT_AFTER_PERCENT=66.67
CHECKOUT_GRACE_MINUTES=10

# Pembatasan login (opsional): username dikunci sementara setelah sekian kali
# password salah dalam sekian menit.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
